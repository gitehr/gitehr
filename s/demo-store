def _latest_id(gitehr, repo, family):
    """The id of the most recently added entry in a typed-state family.

    The add commands print the new id, but reading it back keeps this working
    if that output ever changes.
    """
    import json

    listed = json.loads(gitehr(family, "list", "--json", "--all", cwd=repo))
    if not listed:
        raise SystemExit(f"no {family} recorded")
    return listed[-1]["id"]


