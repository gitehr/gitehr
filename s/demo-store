# ── process helpers ──────────────────────────────────────────────────────────


class Gitehr:
    """Runs the gitehr binary against the demo store and nowhere else.

    Every invocation carries GITEHR_STORE_PATH, so a misconfigured shell or a
    developer's own configured Store cannot be written to by accident.
    """

    def __init__(self, binary, store_root):
        self.binary = binary
        self.env = dict(os.environ, GITEHR_STORE_PATH=str(store_root))

    def __call__(self, *args, cwd=None):
        result = subprocess.run(
            [self.binary, *[str(a) for a in args]],
            cwd=cwd,
            env=self.env,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            eprint(f"gitehr {' '.join(str(a) for a in args)}")
            eprint(result.stdout.strip())
            eprint(result.stderr.strip())
            raise SystemExit(f"gitehr exited {result.returncode}")
        return result.stdout


def configured_store_path(binary):
    """The developer's real Store, so the demo can refuse to overwrite it."""
    try:
        output = subprocess.run(
            [binary, "config", "show"], capture_output=True, text=True, check=True
        ).stdout
    except (subprocess.CalledProcessError, OSError):
        return None
    for line in output.splitlines():
        if line.startswith("store_path:"):
            value = line.split(":", 1)[1].strip()
            return None if value.startswith("<") else os.path.realpath(value)
    return None


# ── synthetic identifiers and documents ──────────────────────────────────────


def nhs_number(seed):
    """A checksum-valid NHS number in the 999 test range.

    Real-looking identifiers make a better demo, and the 999 prefix keeps them
    unmistakably synthetic.
    """
    rng = random.Random(seed)
    while True:
        digits = [9, 9, 9] + [rng.randint(0, 9) for _ in range(6)]
        total = sum(d * (10 - i) for i, d in enumerate(digits))
        check = 11 - (total % 11)
        if check == 11:
            check = 0
        if check == 10:
            continue
        digits.append(check)
        return "".join(str(d) for d in digits)


def write_pdf(path, title, paragraphs):
    """Write a one-page PDF, so the GUI's document preview has real content.

    Hand-rolled rather than pulling in a PDF library for a demo fixture: the
    file only has to be a valid PDF a viewer will render.
    """

    def escape(text):
        return text.replace("\\", r"\\").replace("(", r"\(").replace(")", r"\)")

    lines = [f"BT /F1 14 Tf 72 760 Td ({escape(title)}) Tj ET"]
    y = 730
    for paragraph in paragraphs:
        for chunk in _wrap(paragraph, 88):
            lines.append(f"BT /F1 10 Tf 72 {y} Td ({escape(chunk)}) Tj ET")
            y -= 14
        y -= 8
    stream = "\n".join(lines).encode("latin-1", "replace")

    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] "
        b"/Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
        b"<< /Length "
        + str(len(stream)).encode()
        + b" >>\nstream\n"
        + stream
        + b"\nendstream",
    ]

    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for number, body in enumerate(objects, start=1):
        offsets.append(len(out))
        out += f"{number} 0 obj\n".encode() + body + b"\nendobj\n"

    xref_at = len(out)
    out += f"xref\n0 {len(objects) + 1}\n".encode()
    out += b"0000000000 65535 f \n"
    for offset in offsets:
        out += f"{offset:010d} 00000 n \n".encode()
    out += (
        f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\n"
        f"startxref\n{xref_at}\n%%EOF\n"
    ).encode()

    with open(path, "wb") as handle:
        handle.write(bytes(out))


def _wrap(text, width):
    words, line, out = text.split(), "", []
    for word in words:
        candidate = f"{line} {word}".strip()
        if len(candidate) > width and line:
            out.append(line)
            line = word
        else:
            line = candidate
    if line:
        out.append(line)
    return out


