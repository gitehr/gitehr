def main():
    repo_root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()

    parser = argparse.ArgumentParser(
        description="Build a synthetic GitEHR Store for demos and screenshots"
    )
    parser.add_argument(
        "--output",
        default=os.path.join(repo_root, ".private", "demo-store"),
        help="Where to build the Store (default: .private/demo-store, gitignored)",
    )
    parser.add_argument(
        "--gitehr",
        default=os.path.join(repo_root, "target", "debug", "gitehr"),
        help="gitehr binary to drive (default: target/debug/gitehr)",
    )
    parser.add_argument(
        "--force", action="store_true", help="Replace an existing demo Store"
    )
    args = parser.parse_args()

    binary = args.gitehr
    if os.sep not in binary and shutil.which(binary) is None:
        raise SystemExit(f"gitehr binary not found: {binary}")
    if os.sep in binary and not os.path.exists(binary):
        raise SystemExit(f"gitehr binary not found: {binary}. Run `cargo build` first.")

    store_root = os.path.realpath(args.output)

    configured = configured_store_path(binary)
    if configured and (store_root == configured or store_root.startswith(configured + os.sep)):
        raise SystemExit(
            f"Refusing to build demo data inside your configured Store ({configured}).\n"
            "Pass --output somewhere else."
        )

    if os.path.exists(store_root) and os.listdir(store_root):
        if not args.force:
            raise SystemExit(
                f"{store_root} already exists and is not empty. Re-run with --force to replace it."
            )
        if not os.path.exists(os.path.join(store_root, "gitehr-mpi.json")):
            raise SystemExit(
                f"Refusing to delete {store_root}: it is not a GitEHR Store. "
                "Remove it yourself if that is really what you want."
            )
        shutil.rmtree(store_root)

    os.makedirs(store_root, exist_ok=True)
    gitehr = Gitehr(binary, store_root)

    eprint(f"Building demo Store in {store_root}")

    gitehr("store", "init", "rosalind", cwd=store_root)
    gitehr("store", "add", "theo", cwd=store_root)

    for subject, identifier in [("rosalind", "rosalind"), ("theo", "theo")]:
        repo = os.path.join(store_root, subject)
        for user_id, name, role in CONTRIBUTORS:
            gitehr("user", "add", user_id, name, "--role", role, cwd=repo)
        gitehr("user", "activate", CONTRIBUTORS[0][0], cwd=repo)

    with tempfile.TemporaryDirectory() as work:
        adult_work = os.path.join(work, "rosalind")
        child_work = os.path.join(work, "theo")
        os.makedirs(adult_work)
        os.makedirs(child_work)

        eprint("  rosalind: hypertension, type 2 diabetes, 2017 appendicectomy")
        build_adult(gitehr, os.path.join(store_root, "rosalind"), adult_work)

        eprint("  theo: eczema, asthma, childhood immunisations")
        build_child(gitehr, os.path.join(store_root, "theo"), child_work)

    eprint("")
    eprint("Done. To look around:")
    eprint(f"  cd {store_root}/rosalind && {binary} status")
    eprint(f"  GITEHR_STORE_PATH={store_root} {binary} gui")
    eprint("")
    eprint(
        "Note: typed-state entries (conditions, medications, ...) are stamped today,\n"
        "because those commands cannot record an entry at the time the event happened.\n"
        "Only the imported journal entries carry their real historical dates."
    )

    # Data on stdout, so `cd $(s/demo-store)` works.
    print(store_root)


if __name__ == "__main__":
    main()
