def write_journal_entries(entries, target_dir):
    """Lay out backdated journal entries for `gitehr import --mode journal`.

    The import preserves each entry's filename and front matter verbatim, so
    this is the only way to build a record whose history predates today.
    """
    for when, author, body in entries:
        stamp = when.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%S.%f")[:-3] + "Z"
        name = f"{stamp}-{uuid.uuid4()}.md"
        front = f"---\ntimestamp: {when.astimezone(timezone.utc).isoformat().replace('+00:00', 'Z')}\nauthor: {author}\n---\n\n"
        with open(os.path.join(target_dir, name), "w", encoding="utf-8") as handle:
            handle.write(front + body.strip() + "\n")


def at(year, month, day, hour=9, minute=0):
    return datetime(year, month, day, hour, minute, tzinfo=timezone.utc)


